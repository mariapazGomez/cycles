VITE_API_URL=http://localhost:3000

# Registro abierto (early adopters: cerrado por defecto). Va junto con
# REGISTRATION_OPEN en la API, que es la que lo hace cumplir.
VITE_REGISTRATION_OPEN=false

# PostHog (analítica de uso, T-179). Sin clave queda apagada. La clave es la
# «Project API key» (phc_…) del proyecto en la región UE; va en Vercel, no en el repo.
# docs/deploy/POSTHOG.md
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
