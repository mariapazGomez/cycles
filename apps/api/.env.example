DATABASE_URL="postgresql://user:password@localhost:5432/cycles?schema=public"

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Base de los enlaces de los emails y del redirect después de Google.
FRONTEND_URL=http://localhost:5173

# Orígenes (separados por coma) que pueden llamar a la API desde el
# navegador. Sin definir, solo FRONTEND_URL. Obligatoria en producción.
CORS_ORIGINS=

# Cantidad de proxies delante de la API (Render: 1). En local, 0.
TRUST_PROXY=0

# Email transaccional (Resend). Sin RESEND_API_KEY los emails se escriben en
# el log en vez de enviarse. Ver docs/deploy/PLAN-Deploy.md, paso 1.
RESEND_API_KEY=
MAIL_FROM="Cycles <hola@mail.getcycles.app>"
MAIL_REPLY_TO=

# Alertas de seguridad (docs/PLAN-Seguridad.md, 1E): incoming webhook de
# Slack hacia un canal privado. Es un secreto. Sin definir, las alertas
# solo quedan en el log.
SLACK_SECURITY_WEBHOOK_URL=

# Avisos de actividad del piloto (docs/deploy/PLAN-Deploy.md, paso 8):
# webhook de otro canal (#cycles-actividad). Es un secreto. Solo se envía con
# NODE_ENV=production; para probar el canal en local, SLACK_ACTIVITY_SEND_IN_DEV=true.
SLACK_ACTIVITY_WEBHOOK_URL=
SLACK_ACTIVITY_SEND_IN_DEV=false
# Secreto (64+ caracteres) con el que GitHub Actions llama al resumen diario.
# Sin definir, el endpoint del resumen no existe.
ACTIVITY_CRON_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3000/auth/apple/callback
