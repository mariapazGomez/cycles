generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  coach
  athlete
  admin
}

enum AuthProvider {
  local
  google
  apple
}

enum CoachAthleteStatus {
  pending
  active
  inactive
}

enum WeightUnit {
  kg
  lb
}

enum CycleStatus {
  draft
  active
  completed
  archived
}

enum SessionStatus {
  pending
  completed
  skipped
}

// Ver docs/prds/features/PRD-EjecucionYSeguimiento.md.
enum SessionOutcome {
  completed
  skipped
}

enum MuscleGroup {
  chest
  back
  legs
  glutes
  shoulders
  arms
  core
  cardio
  other
}

// Ver docs/prds/features/PRD-RutinasYProgramacion.md.
enum CycleType {
  microcycle
  mesocycle
  macrocycle
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  name               String
  passwordHash       String?
  // Nulo hasta completar onboarding (ej. tras registro vía Google, que no provee rol).
  role               UserRole?
  authProvider       AuthProvider @default(local)
  weightUnit         WeightUnit   @default(kg)
  emailVerifiedAt    DateTime?
  dataConsentAt      DateTime?
  dataConsentVersion String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  coachRelations          CoachAthlete[]           @relation("CoachRelations")
  athleteRelations        CoachAthlete[]           @relation("AthleteRelations")
  cyclesAsCoach           TrainingCycle[]          @relation("CyclesAsCoach")
  cyclesAsAthlete         TrainingCycle[]          @relation("CyclesAsAthlete")
  exerciseLogs            ExerciseLog[]
  sessionFeedback         SessionFeedback[]
  loadAdjustments         LoadAdjustment[]
  createdExercises        Exercise[]
  routines                Routine[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  refreshTokens           RefreshToken[]
}

// Refresh tokens persistidos (hasheados) para poder rotarlos y revocarlos,
// no solo confiar en la expiración del JWT. Ver docs/ARCHITECTURE.md, sección 7.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Regla de negocio: un atleta tiene como máximo una relación con status=active
// a la vez. No se modela como constraint de DB (requeriría un unique índex
// parcial vía SQL crudo); se aplica en la capa de servicio antes de crear
// o reactivar una relación. Ver docs/prds/PRD-General.md, sección 4.
model CoachAthlete {
  id        String             @id @default(uuid())
  coachId   String
  athleteId String
  status    CoachAthleteStatus @default(pending)
  createdAt DateTime           @default(now())

  coach           User                    @relation("CoachRelations", fields: [coachId], references: [id])
  athlete         User                    @relation("AthleteRelations", fields: [athleteId], references: [id])
  invitationToken AthleteInvitationToken?

  @@unique([coachId, athleteId])
}

// Token de un solo uso para que el atleta invitado active su cuenta
// (defina contraseña) y la relación pase de 'pending' a 'active'.
// Ver docs/prds/features/PRD-InvitacionAtletas.md.
model AthleteInvitationToken {
  id             String    @id @default(uuid())
  coachAthleteId String    @unique
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  coachAthlete CoachAthlete @relation(fields: [coachAthleteId], references: [id])
}

// Ver docs/prds/features/PRD-RutinasYProgramacion.md para el porqué de
// cycleType/sessionsPerWeek/parentCycleId (pivot del 2026-09-23).
model TrainingCycle {
  id              String      @id @default(uuid())
  coachId         String
  athleteId       String
  name            String
  objective       String?
  startDate       DateTime
  endDate         DateTime
  status          CycleStatus @default(draft)
  isTemplate      Boolean     @default(false)
  templateId      String?
  cycleType       CycleType   @default(mesocycle)
  // Frecuencia semanal, define las filas del grid. Null cuando cycleType es
  // 'macrocycle': un macrociclo no tiene grid propio, es un contenedor.
  sessionsPerWeek Int?
  // Si este plan vive dentro de un macrociclo contenedor.
  parentCycleId   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  coach           User              @relation("CyclesAsCoach", fields: [coachId], references: [id])
  athlete         User              @relation("CyclesAsAthlete", fields: [athleteId], references: [id])
  template        TrainingCycle?    @relation("CycleTemplate", fields: [templateId], references: [id])
  copies          TrainingCycle[]   @relation("CycleTemplate")
  parentCycle     TrainingCycle?    @relation("CycleContainer", fields: [parentCycleId], references: [id])
  childCycles     TrainingCycle[]   @relation("CycleContainer")
  sessions        TrainingSession[]
  loadAdjustments LoadAdjustment[]
}

// Biblioteca de rutinas reutilizables del coach — ver PRD-RutinasYProgramacion.
model Routine {
  id        String   @id @default(uuid())
  coachId   String
  name      String
  createdAt DateTime @default(now())

  coach            User              @relation(fields: [coachId], references: [id])
  routineExercises RoutineExercise[]
  sessions         TrainingSession[]
}

// La "receta" por defecto de una rutina. Al asignar la rutina a una celda
// del grid, estas filas se copian como SessionExercise editables — cambiar
// una copia no afecta esta plantilla.
model RoutineExercise {
  id                 String @id @default(uuid())
  routineId          String
  exerciseId         String
  orderIndex         Int
  defaultSets        Int
  defaultReps        Int
  defaultWeight      Float?
  defaultRestSeconds Int?
  // Esfuerzo objetivo en repeticiones en reserva (0–4). Null = sin objetivo:
  // ese ejercicio no genera alertas de carga.
  defaultRir         Int?

  routine  Routine  @relation(fields: [routineId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id])
}

// Una celda del grid (weekNumber, slotNumber) dentro de un plan.
model TrainingSession {
  id            String        @id @default(uuid())
  cycleId       String
  name          String
  weekNumber    Int
  slotNumber    Int
  scheduledDate DateTime?
  status        SessionStatus @default(pending)
  // De qué rutina de la biblioteca salió — guardado para trazabilidad, no
  // se muestra en la UI (decisión del 2026-09-23).
  routineId     String?
  // Lo marca el atleta al empezar; base para pre-calcular la duración.
  startedAt     DateTime?

  cycle            TrainingCycle     @relation(fields: [cycleId], references: [id])
  routine          Routine?          @relation(fields: [routineId], references: [id], onDelete: SetNull)
  sessionExercises SessionExercise[]
  feedback         SessionFeedback[]

  @@unique([cycleId, weekNumber, slotNumber])
}

model Exercise {
  id          String       @id @default(uuid())
  name        String
  muscleGroup MuscleGroup?
  description String?
  videoUrl    String?
  // null = catálogo global (seed); no-null = ejercicio propio de ese coach.
  createdBy   String?
  // Permite ocultar un ejercicio propio sin borrarlo (protege el historial
  // de SessionExercise/ExerciseLog que ya lo referencian). No aplica al
  // catálogo global en esta iteración.
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  creator          User?             @relation(fields: [createdBy], references: [id])
  sessionExercises SessionExercise[]
  routineExercises RoutineExercise[]
  loadAdjustments  LoadAdjustment[]
}

model SessionExercise {
  id                String @id @default(uuid())
  sessionId         String
  exerciseId        String
  orderIndex        Int
  targetSets        Int
  targetReps        Int
  targetWeight      Float?
  targetRestSeconds Int?
  // Copiado de RoutineExercise.defaultRir al asignar; editable por celda.
  targetRir         Int?

  session  TrainingSession @relation(fields: [sessionId], references: [id])
  exercise Exercise        @relation(fields: [exerciseId], references: [id])
  logs     ExerciseLog[]
}

// Un registro por serie. Append-only: nunca se actualiza ni se borra; una
// corrección es una fila nueva con supersedesId apuntando a la anterior, y el
// dato vigente es la fila que nadie reemplazó. El id lo genera el cliente para
// que un reintento no duplique la serie. Ver PRD-EjecucionYSeguimiento.
model ExerciseLog {
  id                String   @id @default(uuid())
  sessionExerciseId String
  athleteId         String
  setNumber         Int
  actualReps        Int
  // Siempre en kg; null = peso corporal.
  actualWeight      Float?
  // Repeticiones en reserva (0–4, 4 = "4 o más"). Se pide en la última serie.
  rir               Int?
  supersedesId      String?  @unique
  loggedAt          DateTime @default(now())

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id])
  athlete         User            @relation(fields: [athleteId], references: [id])
  supersedes      ExerciseLog?    @relation("LogCorrection", fields: [supersedesId], references: [id])
  supersededBy    ExerciseLog?    @relation("LogCorrection")

  @@index([sessionExerciseId])
}

// Cierre de una sesión por parte del atleta. Append-only, igual que ExerciseLog.
// TrainingSession.status se deriva del feedback vigente.
model SessionFeedback {
  id              String         @id @default(uuid())
  sessionId       String
  athleteId       String
  outcome         SessionOutcome
  // Esfuerzo de la sesión (sRPE, escala CR-10 de Foster). Obligatorio si completed.
  srpe            Int?
  durationMinutes Int?
  pain            Boolean        @default(false)
  painNotes       String?
  // Nota libre, o el motivo si outcome = skipped.
  notes           String?
  supersedesId    String?        @unique
  submittedAt     DateTime       @default(now())

  session      TrainingSession  @relation(fields: [sessionId], references: [id])
  athlete      User             @relation(fields: [athleteId], references: [id])
  supersedes   SessionFeedback? @relation("FeedbackCorrection", fields: [supersedesId], references: [id])
  supersededBy SessionFeedback? @relation("FeedbackCorrection")

  @@index([sessionId])
}

// Ajuste de carga aceptado por el coach: qué cambió, desde cuándo y por qué.
// Se guarda para poder medir después si los ajustes funcionaron.
model LoadAdjustment {
  id            String   @id @default(uuid())
  coachId       String
  cycleId       String
  exerciseId    String
  fromWeek      Int
  percentChange Float
  // Regla que la originó (high_load, low_load) o "manual".
  reason        String
  affectedCount Int
  createdAt     DateTime @default(now())

  coach    User          @relation(fields: [coachId], references: [id])
  cycle    TrainingCycle @relation(fields: [cycleId], references: [id])
  exercise Exercise      @relation(fields: [exerciseId], references: [id])
}
